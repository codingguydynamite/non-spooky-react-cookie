{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "non-spooky-react-cookie": ["../../src/index.ts"],
      "non-spooky-react-cookie/server": ["../../src/server.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
